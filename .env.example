# 复制为 .env 再填。.env 不会进 git。

# 公众号 开发接口：公众号后台 → 设置与开发 → 基本配置
WECHAT_APPID=
WECHAT_SECRET=

# 通知（可选）：草稿推好了 / 今天没稿 时提醒你
#   wecom      企业微信群机器人，填 NOTIFY_WEBHOOK
#   serverchan Server酱，填 SERVERCHAN_KEY（推到个人微信）
NOTIFY_TYPE=
NOTIFY_WEBHOOK=
SERVERCHAN_KEY=

# AI 写稿（可选，OpenAI 兼容接口）
GZH_LLM_BASE_URL=
GZH_LLM_MODEL=
GZH_LLM_KEY=

# AI 封面（可选，OpenAI 兼容 images/generations）
GZH_IMAGE_BASE_URL=
GZH_IMAGE_MODEL=
GZH_IMAGE_KEY=
